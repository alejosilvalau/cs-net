@page "/alumnos"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using LabBlazor.Data
@using LabBlazor.Models
@inject LabBlazorContext DbCtx
<PageTitle>Alumnos</PageTitle>

<h1>Alumnos</h1>
<p>Comisi&oacute;n 1</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Legajo</th>
            <th>Dirección</th>
            <th>Detalle</th>
            <th>Editar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var alumno in alumnos)
        {
            <tr>
                <td>@alumno.Nombre</td>
                <td>@alumno.Apellido</td>
                <td>@alumno.Legajo</td>
                <td>@alumno.Direccion</td>
                <td><a href="/alumnos/@alumno.Id">Ver detalle</a></td>
                <td><a href="/alumnos/editar/@alumno.Id">Editar</a></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Alumno> alumnos = new();

    protected override async Task OnParametersAsync()
    {
        alumnos = await DbCtx.Alumnos.ToListAsync();
    }
}
